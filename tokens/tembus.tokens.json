  "global": {
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "32px"
    },
    "radius": {
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "pill": "999px"
    },
    "typography": {
      "display": "clamp(2.25rem, 5vw, 3.75rem)",
      "page-title": "clamp(1.75rem, 3vw, 2.25rem)",
      "section-title": "1.25rem",
      "body": "1rem",
      "body-small": "0.875rem",
      "label": "0.8125rem",
      "caption": "0.75rem",
      "table-cell": "0.8125rem"
    },
    "elevation": {
      "none": "none",
      "raised": "0 4px 16px rgba(20, 33, 26, 0.12)",
      "overlay": "0 12px 32px rgba(20, 33, 26, 0.18)"
    },
    "motion": {
      "fast": "150ms",
      "standard": "200ms",
      "slow": "300ms",
      "easing": "cubic-bezier(0.2, 0, 0, 1)",
      "reduced": "0ms"
    },
    "size": {
      "min-touch-target": "48px",
      "control-large": "56px",
      "icon": "24px",
      "icon-small": "16px"
    },
    "content": {
      "max-width": "1200px",
      "grid-gap": "16px"
    },
    "fontFamily": {
      "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "document": "Aptos, \"Segoe UI\", Arial, sans-serif",
      "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "typographyStyles": {
      "display": {
        "lineHeight": 1.1,
        "weight": 700,
        "nativeSize": 36
      },
      "page-title": {
        "lineHeight": 1.2,
        "weight": 700,
        "nativeSize": 28
      },
      "section-title": {
        "lineHeight": 1.5,
        "weight": 700,
        "nativeSize": 20
      },
      "body": {
        "lineHeight": 1.5,
        "weight": 400,
        "nativeSize": 16
      },
      "body-small": {
        "lineHeight": 1.5,
        "weight": 400,
        "nativeSize": 14
      },
      "label": {
        "lineHeight": 1.25,
        "weight": 600,
        "nativeSize": 13
      },
      "caption": {
        "lineHeight": 1.5,
        "weight": 500,
        "nativeSize": 12
      },
      "table-cell": {
        "lineHeight": 1.4,
        "weight": 400,
        "nativeSize": 13
      }
    },
    "palette": {
      "forest-950": "#001F12",
      "forest-900": "#002B18",
      "forest-800": "#003A20",
      "forest-600": "#0B6A3B",
      "orange-bright": "#FF6A00"
    },
    "breakpoint": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px"
    },
    "zIndex": {
      "base": "0",
      "dropdown": "1000",
      "sticky": "1020",
      "overlay": "1040",
      "modal": "1050",
      "toast": "1080"
    }
  },
  "wcagProtectedPairs": [
    { "foreground": "foreground", "background": "background", "minimum": 4.5, "purpose": "normal text on page background" },
    { "foreground": "foreground-secondary", "background": "background", "minimum": 4.5, "purpose": "secondary text on page background" },
    { "foreground": "foreground-muted", "background": "background", "minimum": 4.5, "purpose": "muted text on page background" },
    { "foreground": "foreground", "background": "surface", "minimum": 4.5, "purpose": "normal text on surfaces" },
    { "foreground": "foreground-secondary", "background": "surface", "minimum": 4.5, "purpose": "secondary text on surfaces" },
    { "foreground": "foreground-muted", "background": "surface", "minimum": 4.5, "purpose": "muted text on surfaces" },
    { "foreground": "on-primary", "background": "primary", "minimum": 4.5, "purpose": "primary action text" },
    { "foreground": "on-accent", "background": "accent", "minimum": 4.5, "purpose": "accent action text" },
    { "foreground": "on-success", "background": "success", "minimum": 4.5, "purpose": "success status text" },
    { "foreground": "on-warning", "background": "warning", "minimum": 4.5, "purpose": "warning status text" },
    { "foreground": "on-error", "background": "error", "minimum": 4.5, "purpose": "error status text" },
    { "foreground": "on-info", "background": "info", "minimum": 4.5, "purpose": "info status text" },
    { "foreground": "border-strong", "background": "background", "minimum": 3, "purpose": "essential component boundary" },
    { "foreground": "input-border", "background": "input-background", "minimum": 3, "purpose": "input boundary" },
    { "foreground": "focus-ring", "background": "background", "minimum": 3, "purpose": "keyboard focus indicator" },
    { "foreground": "focus-ring", "background": "surface", "minimum": 3, "purpose": "keyboard focus indicator on surfaces" },
    { "foreground": "success", "background": "success-surface", "minimum": 4.5, "purpose": "status text on tinted surface" },
    { "foreground": "warning", "background": "warning-surface", "minimum": 4.5, "purpose": "status text on tinted surface" },
    { "foreground": "error", "background": "error-surface", "minimum": 4.5, "purpose": "status text on tinted surface" },
    { "foreground": "info", "background": "info-surface", "minimum": 4.5, "purpose": "status text on tinted surface" },
    { "foreground": "primary", "background": "background", "minimum": 4.5, "purpose": "brand text on page background" },
    { "foreground": "accent", "background": "background", "minimum": 4.5, "purpose": "accent text on page background" },
    { "foreground": "focus-ring", "background": "surface-subtle", "minimum": 3, "purpose": "focus indicator on subtle surfaces" },
    { "foreground": "on-primary-dark", "background": "primary-dark", "minimum": 4.5, "purpose": "text on deep brand surface" },
    { "foreground": "on-accent-light", "background": "accent-light", "minimum": 4.5, "purpose": "text on light accent surface" },
    { "foreground": "on-primary", "background": "primary-light", "minimum": 4.5, "purpose": "text on primary-light" },
    { "foreground": "primary", "background": "surface-subtle", "minimum": 4.5, "purpose": "brand text on subtle surface" },
    { "foreground": "foreground-muted", "background": "surface-subtle", "minimum": 4.5, "purpose": "muted text on subtle surface" },
    { "foreground": "dataviz-1", "background": "surface", "minimum": 3, "purpose": "chart series on surface (non-text)" },
    { "foreground": "dataviz-1", "background": "surface-subtle", "minimum": 3, "purpose": "chart series on subtle surface (non-text)" },
    { "foreground": "dataviz-2", "background": "surface", "minimum": 3, "purpose": "chart series on surface (non-text)" },
    { "foreground": "dataviz-2", "background": "surface-subtle", "minimum": 3, "purpose": "chart series on subtle surface (non-text)" },
    { "foreground": "dataviz-3", "background": "surface", "minimum": 3, "purpose": "chart series on surface (non-text)" },
    { "foreground": "dataviz-3", "background": "surface-subtle", "minimum": 3, "purpose": "chart series on subtle surface (non-text)" },
    { "foreground": "dataviz-4", "background": "surface", "minimum": 3, "purpose": "chart series on surface (non-text)" },
    { "foreground": "dataviz-4", "background": "surface-subtle", "minimum": 3, "purpose": "chart series on subtle surface (non-text)" },
    { "foreground": "dataviz-5", "background": "surface", "minimum": 3, "purpose": "chart series on surface (non-text)" },
    { "foreground": "dataviz-5", "background": "surface-subtle", "minimum": 3, "purpose": "chart series on subtle surface (non-text)" },
    { "foreground": "dataviz-6", "background": "surface", "minimum": 3, "purpose": "chart series on surface (non-text)" },
    { "foreground": "dataviz-6", "background": "surface-subtle", "minimum": 3, "purpose": "chart series on subtle surface (non-text)" }
  ],
  "platformMappings": {
    "cssVariablePrefix": "--token-",
    "android": {
      "nameOverrides": { "foreground": "OnBackground", "foreground-secondary": "OnSurfaceSecondary", "foreground-muted": "OnSurfaceVariant", "border": "Outline", "border-strong": "OutlineStrong", "input-border": "InputBorder" }
    }
  }
